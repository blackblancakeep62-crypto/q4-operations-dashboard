# 本机开发允许访问。生产环境无论此值如何都要求账号密码。
DASHBOARD_LOCAL_ONLY=true
DASHBOARD_USERNAME=manager
# 生产环境必须设置至少20字符随机密码，结合HTTPS/VPN或SSO网关
DASHBOARD_PASSWORD=
GOOGLE_SPREADSHEET_ID=
# 二选一：服务账号文件 / JSON (仅服务端，不加 NEXT_PUBLIC_)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=
# 或 OAuth 离线授权
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# 12月真实ERP子表名，未配置不猜测
DECEMBER_SHEET_NAME=
CACHE_DIR=.private

# 历史源数据变化时手动更新版本，触发一次重建
HISTORY_SOURCE_REVISION=initial
# HTTPS反向代理部署时设置外部访问源，例如 https://q4.company.internal
APP_ORIGIN=
